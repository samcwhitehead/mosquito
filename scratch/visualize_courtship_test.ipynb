    "# plot Zoomed in view of spectrogram\n",
    "fig, ax = plt.subplots(figsize=(4, 1.35))\n",
    "\n",
    "t_min_zoom = 250\n",
    "t_max_zoom = 350\n",
    "\n",
    "f_min_zoom = 1250\n",
    "f_max_zoom = 1500\n",
    "\n",
    "t_keep_idx = (t >= t_min_zoom) & (t <= t_max_zoom)\n",
    "t_zoom = t[t_keep_idx]\n",
    "\n",
    "freq_keep_idx = (freq >= f_min_zoom) & (freq <= f_max_zoom)\n",
    "freq_zoom = freq[freq_keep_idx]\n",
    "\n",
    "Zxx_zoom = Zxx.copy()\n",
    "Zxx_zoom = Zxx_zoom[freq_keep_idx,:]\n",
    "Zxx_zoom = Zxx_zoom[:, t_keep_idx]\n",
    "\n",
    "# plot data\n",
    "ax.pcolormesh(t_zoom, freq_zoom, np.abs(Zxx_zoom), \n",
    "              shading='gouraud',\n",
    "              norm='log',\n",
    "              cmap = plt.colormaps[\"Blues\"],\n",
    "              vmin=0.0005,\n",
    "              vmax=np.max(np.abs(Zxx_zoom)),\n",
    "             )\n",
    "# ax.plot(t_full, wbf, 'r-')\n",
    "\n",
    "ax.set_ylim([MIC_LOWCUT, MIC_HIGHCUT])\n",
    "\n",
    "\n",
    "# label axes\n",
    "# ax.set_title('STFT Magnitude')\n",
    "ax.set_ylabel('frequency (Hz)')\n",
    "ax.set_xlabel('time (s)')\n",
    "ax.tick_params(direction='in')\n",
    "\n",
    "ax.set_xlim([t_min_zoom, t_max_zoom])\n",
    "ax.set_ylim([f_min_zoom, f_max_zoom])\n",
    "plt.show()\n",
    "fig.savefig(r\"/media/sam/SamData/Dropbox/Conferences/expr106_axo0000_spectrogram_zoom.png\",dpi=save_dpi, bbox_inches='tight')"
   ]
